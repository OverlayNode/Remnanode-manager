#!/usr/bin/env bash
set -Eeuo pipefail

RN_ENTRYPOINT="${BASH_SOURCE[0]}"
while [[ -h "$RN_ENTRYPOINT" ]]; do
  RN_LINK_DIR="$(cd -P "$(dirname "$RN_ENTRYPOINT")" >/dev/null 2>&1 && pwd)"
  RN_ENTRYPOINT="$(readlink "$RN_ENTRYPOINT")"
  [[ "$RN_ENTRYPOINT" == /* ]] || RN_ENTRYPOINT="${RN_LINK_DIR}/${RN_ENTRYPOINT}"
done
RN_ROOT="$(cd -P "$(dirname "$RN_ENTRYPOINT")" >/dev/null 2>&1 && pwd)"
unset RN_ENTRYPOINT RN_LINK_DIR
export RN_ROOT

for module in common ui system network docker backup reality snippets config node xray panel selfsteal ssl firewall logs diagnostics warp tor routing update session security; do
  # shellcheck source=/dev/null
  source "${RN_ROOT}/lib/${module}.sh"
done

usage() {
  cat <<'EOF'
Usage: remnanode [--json] [--dry-run] COMMAND [ARGS]

  status | doctor [--export FILE]
  node status|start|stop|restart|update|logs|inspect
  xray status|version|restart|validate|logs
  reality generate | reality shortids list|regenerate [COUNT]
  config generate|print|view|edit|export FILE|apply
  snippet list|show|print|enable|disable|export|validate|merge
  warp status|install|test|outbound [TAG]
  routing list|enable|disable
  backup create|list|restore PATH
  schedule install|status
  panel status|test
  firewall status | firewall ping status|disable|enable
  selfsteal status|doctor|generate THEME
  logs SOURCE [50|100|500|live|1h|24h]
  menu
EOF
}

main() {
  RN_JSON=0 RN_DRY_RUN=0 RN_ASSUME_YES=0
  local -a args=()
  while (($#)); do
    case "$1" in
      --json) RN_JSON=1 ;;
      --dry-run) RN_DRY_RUN=1 ;;
      --yes|-y) RN_ASSUME_YES=1 ;;
      --help|-h) usage; return 0 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  export RN_JSON RN_DRY_RUN RN_ASSUME_YES
  set -- "${args[@]}"
  rn_init
  local command="${1:-menu}"; shift || true
  case "$command" in
    menu) session_ensure_tmux; ui_main_menu ;;
    status) system_status "${1:-}" ;;
    doctor) diagnostics_doctor "$@" ;;
    node) node_command "$@" ;;
    xray) xray_command "$@" ;;
    reality) reality_command "$@" ;;
    config) config_command "$@" ;;
    snippet|snippets) snippets_command "$@" ;;
    warp) warp_command "$@" ;;
    tor) tor_command "$@" ;;
    routing) routing_command "$@" ;;
    backup) backup_command "$@" ;;
    schedule) scheduled_tasks_command "$@" ;;
    panel) panel_command "$@" ;;
    selfsteal) selfsteal_command "$@" ;;
    ssl) ssl_command "$@" ;;
    firewall) firewall_command "$@" ;;
    logs) logs_command "$@" ;;
    update|self-update) update_command "$@" ;;
    install) exec "${RN_ROOT}/install.sh" ;;
    help) usage ;;
    *) rn_error "Unknown command: ${command}"; usage >&2; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
